<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS virtual directory /lab-setup under the libdesk site (C:\Websites\static\lab-setup).
     Serves the LAN bootstrap (go.txt) + lab.ps1 + config.json to lab PCs that are not logged in to the
     captive portal yet. Only these public files live here: secrets stay on the LabDeploy share. -->
<configuration>
  <system.webServer>
    <!-- the parent site proxies everything to Next.js; files here are served by IIS itself -->
    <rewrite>
      <rules>
        <clear />
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".ps1" />
      <mimeMap fileExtension=".ps1" mimeType="text/plain; charset=utf-8" />
    </staticContent>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false">
          <add fileExtension=".txt" allowed="true" />
          <add fileExtension=".ps1" allowed="true" />
          <add fileExtension=".json" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
